{
  "@context": {
    "@vocab": "https://schema.org/",
    "athena": "https://aws.amazon.com/athena/",
    "QueryExecution": "athena:QueryExecution",
    "QueryExecutionId": "athena:queryExecutionId",
    "QueryString": "athena:queryString",
    "NamedQuery": "athena:NamedQuery",
    "NamedQueryId": "athena:namedQueryId",
    "WorkGroup": "athena:WorkGroup",
    "DataCatalog": "athena:DataCatalog",
    "Database": "athena:Database",
    "TableMetadata": "athena:TableMetadata",
    "PreparedStatement": "athena:PreparedStatement",
    "Tag": "athena:Tag"
  }
}